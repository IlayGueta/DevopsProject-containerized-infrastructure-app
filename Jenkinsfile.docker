@Library('my-shared-library') _

pipeline {
    agent any

    environment {
        APP_NAME = 'ilay-infrastructure-api'
        CONTAINER_NAME = 'infrastructure-api-test'
    }

    stages {
        stage('parallel sonarqube build'){
            parallel {

                stage('Build Docker Image') {
                    steps {
                        script {
                            myLibrary.buildImage(env.APP_NAME)
                        }
                    }
                }

                stage('scan sonarqube') {
                    steps {
                        script {
                            codeQuality.sonarScantest()
                        }
                    }
                }
            }            
        }

        stage('Push to DockerHub') {
            steps {
                script {
                    myLibrary.pushDocker(env.APP_NAME, 'ilay-dockerhub')
                }
            }
        }

        stage('Run Docker Image') {
            steps {
                script {
                    myLibrary.dockerImage(env.APP_NAME, 5001, 5000, env.CONTAINER_NAME)
                }
            }
        }

        stage('Health') {
            steps {
                script {
                    myLibrary.healthCheck(5001, '/health', 10, 'host.docker.internal')
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    myLibrary.test()
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    myLibrary.deploy()
                }
            }
        }
    }

    post {
        always {
            sh "docker rm -f ${env.CONTAINER_NAME} || true"
        }

        failure {
            echo 'The pipeline failed!'
        }

        success {
            echo 'The pipeline finished successfully!'
        }
    }
}
